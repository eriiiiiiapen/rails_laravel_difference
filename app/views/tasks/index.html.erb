<% content_for :title, "Tasks" %>

<h1>Tasks</h1>

<div data-controller="search">
  <%= form_with url: :tasks, method: :get, data: { search_target: "form" } do |f| %>
    <%= f.text_field :search_params,
      placeholder: "タスクを検索...",
      data: { action: "input->search#submit" } 
    %>
  <% end %>
</div>

<div id="result_tasks">
  <%= render @tasks %>
</div>

<%= link_to "New task", new_task_path %>

<div data-controller="hello">
  <button data-action="click->hello#greet">クリック</button>
  <span data-hello-target="test"></span>
  <span data-hello-target="test2"></span>
</div>
